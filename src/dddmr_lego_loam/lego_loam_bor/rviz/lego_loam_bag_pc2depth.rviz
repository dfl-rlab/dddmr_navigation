    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /PC01/Topic1
        - /PC11/Topic1
        - /PC21/Topic1
        - /PC31/Topic1
      Splitter Ratio: 0.5
    Tree Height: 449
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: PC1
