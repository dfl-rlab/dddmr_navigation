<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://eprosima.com" version="2.0">

    <transport_descriptors>
        <transport_descriptor>
            <transport_id>UdpTransport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>192.168.0.2</address>
            </interfaceWhiteList>
            <sendBufferSize>33554432</sendBufferSize>    <!-- 32 MB -->
            <receiveBufferSize>33554432</receiveBufferSize> <!-- 32 MB -->
            <maxMessageSize>65500</maxMessageSize>       <!-- Max Packet -->
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="custom_participant" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>UdpTransport</transport_id>
            </userTransports>
        </rtps>
    </participant>

    <publisher profile_name="default_publisher" is_default_profile="true">
        <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
        <qos>
            <reliability>
                <kind>RELIABLE</kind>
            </reliability>
            <durability>
                <kind>VOLATILE</kind>
            </durability>
            <data_sharing>
                <kind>AUTOMATIC</kind>
            </data_sharing>
        </qos>
    </publisher>

    <subscriber profile_name="default_subscriber" is_default_profile="true">
        <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
        <qos>
            <reliability>
                <kind>BEST_EFFORT</kind>
            </reliability>
            <durability>
                <kind>VOLATILE</kind>
            </durability>
            <data_sharing>
                <kind>AUTOMATIC</kind>
            </data_sharing>
        </qos>
    </subscriber>

</profiles>
